# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gigora?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars

# Email Service (SMTP - Brevo / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="GigOra" <no-reply@gigora.dev>

# Optional: Google OAuth 2.0 (for Google Social Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
